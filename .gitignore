karabiner/.config/karabiner/automatic_backups
hammerspoon/.hammerspoon/.settings.json
hammerspoon/.hammerspoon/Spoons/EmmyLua.spoon
hammerspoon/.hammerspoon/Spoons/ReloadConfiguration.spoon
Brewfile.lock.json
# Written by ./upgrade.sh --dump, for diffing against the curated Brewfile.
# Never committed: the Brewfile is hand-maintained.
Brewfile.generated
fish/.config/fish/fish_variables
fish/.config/fish/completions
fish/.config/fish/conf.d
fish/.config/fish/functions
# There is deliberately no `!fish/.config/fish/functions/my_*.fish` line here
# any more. It looked like it protected those files and did nothing at all: git
# does not descend into an excluded directory, so a negation inside one can
# never match. The tracked functions survived only because they were already
# tracked -- a fresh clone-and-add would have dropped them. The exception is
# expressed where it can actually work, in the fish package's own
# fish/.gitignore, which re-opens the directory before re-including files.
vim/.vim/swaps
ssh/.ssh/known_hosts*
ssh/.ssh/asap
direnv/.config/direnv/lib
# Optional machine-local Ghostty settings, included by the tracked config.
ghostty/.config/ghostty/config.local

# Agent skills. The lockfile is written by the skills CLI, which rewrites
# skillFolderHash and updatedAt whenever a skill updates -- so a stowed, tracked
# copy showed up dirty in this repo constantly and blocked `ward repo refresh`.
# The durable intent (which skills, from where) is tracked in
# agents/.agents/skills.list instead; the lockfile is state, so it is ignored.
agents/.agents/.skill-lock.json
