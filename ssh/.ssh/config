# ~/.ssh/config
#
# ORDERING IS LOAD-BEARING. OpenSSH keeps the FIRST value it obtains for any
# given keyword and ignores every later one, so specific blocks must precede
# general ones and the 1Password blocks below must stay in this order. Moving a
# block up or down changes behaviour silently.
#
# Check what any host actually resolves to without connecting:
#   ssh -G <host>

Host bb2
    HostName bb2.rufus
    User ryan
    LocalForward 8882 localhost:8888

# --- 1Password SSH agent ----------------------------------------------------
#
# The agent socket lives somewhere different on each platform:
#
#   macOS  ~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock
#   Linux  ~/.1password/agent.sock
#
# so each block tests for its own socket with `Match exec` rather than
# hardcoding one path and being wrong on the other machine. Testing for the
# socket rather than for the OS also means a host with no 1Password installed
# matches neither block and falls through to whatever SSH_AUTH_SOCK already
# points at — which is what you want, instead of pinning IdentityAgent at a path
# that does not exist and getting no agent at all.
#
# %d expands to the local user's home directory, so nothing here hardcodes a
# username. The inner single quotes are what survive the space in "Group
# Containers" when ssh hands the string to /bin/sh.
#
# On macOS you can collapse both cases by symlinking the short path once:
#   ln -s ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock \
#         ~/.1password/agent.sock

Match exec "test -S '%d/.1password/agent.sock'"
    IdentityAgent ~/.1password/agent.sock

Match exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Removed: `Include /Users/ryan/.config/dev/ssh/include` — Shopify's `dev` tool,
# gone with the job. It was also an absolute path with the home directory
# baked in, so it could not have worked under any other account.
#
# Removed: a commented-out Secretive IdentityAgent block
# (~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh).
# Superseded by 1Password, macOS-only, and commented out for long enough that
# the socket path is no longer worth trusting.
