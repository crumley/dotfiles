# Ghostty configuration
#
# docs:     ghostty +show-config --default --docs | nvim
# check:    ghostty +show-config          (shows what this file actually resolved to)
# examples: https://github.com/search?q=path%3Aghostty%2Fconfig&type=code
#
# Ghostty runs on macOS and Linux and parses the same key set on both: keys that
# only mean something on one platform (the macos-* block below, gtk-*/linux-* on
# the other side) are accepted and ignored elsewhere, so this file needs no
# per-platform split.

# Shell. GUI launchers on macOS give applications only the system PATH, even
# when the user's launchd domain has a richer one. Start a POSIX login shell so
# ~/.profile can discover Homebrew (or another package manager), then replace
# it with fish; no package-manager prefix is embedded here. The wrapper hides
# fish from Ghostty's basename-based shell detection, so force the supported
# fish integration explicitly. If fish is not installed, set `command =` and
# `shell-integration = detect` in config.local (see the bottom) to use the
# account's login shell instead.
command = /bin/sh -l -c "exec fish -l"
shell-integration = fish

copy-on-select = clipboard
mouse-hide-while-typing = true

# ghostty +list-themes
theme = "Dracula+"
alpha-blending = linear-corrected
background-opacity = 0.7
background-blur-radius = 40

window-padding-x = 10
window-padding-y = 2

# ghostty +list-fonts
font-family = "Hack Nerd Font Mono"
font-size = 14

# Alternate fonts, kept as a menu -- uncomment one block at a time.
#
# Atkinson Hyperlegible Mono
# font-family = "Atkinson Hyperlegible Mono"
#
# Berkeley Mono -- https://usgraphics.com/products/berkeley-mono
# font-family = "Berkeley Mono Variable"
# font-variation = wght=300
# font-variation = wdth=100
# font-family-bold = "Berkeley Mono Variable"
# font-variation-bold = wght=800
#
# Maple Mono for italics -- https://github.com/subframe7536/maple-font
# font-family-italic = "Maple Mono"
# font-variation-italic = wght=200
# font-family-bold-italic = "Maple Mono"
# font-variation-bold-italic = wght=800

# Quick terminal. The global: prefix needs Ghostty 1.0+ on macOS, 1.2+ on Linux;
# `command` there is the Super key on Linux.
keybind = global:shift+ctrl+alt+command+d=toggle_quick_terminal
quick-terminal-animation-duration = 0
quick-terminal-space-behavior = "move"

# macOS-only; ignored on other platforms.
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true

# Per-machine overrides, if this box needs any. The leading ? makes the include
# optional, so nothing breaks when the file does not exist. Loaded last, so it
# wins over everything above.
config-file = ?config.local
