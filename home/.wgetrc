# ~/.wgetrc — wget defaults. (wget is in the Brewfile; curl is the usual reach,
# but wget still wins for mirroring a tree.)

# Use the server-provided last modification date, if available
timestamping = on

# Do not go up in the directory structure when downloading recursively
no_parent = on

# Wait 60 seconds before timing out. This applies to all timeouts: DNS, connect
# and read. (The default read timeout is 15 minutes!)
timeout = 60

# Retry a few times when a download fails, but don't overdo it. (Default: 20)
tries = 3

# Retry even when the connection was refused
retry_connrefused = on

# Use the last component of a redirection URL for the local file name
trust_server_names = on

# Add a `.html` extension to `text/html` or `application/xhtml+xml` files that
# lack one, or a `.css` extension to `text/css` files that lack one
adjust_extension = on

# Deliberately not set here:
#   user_agent  — this file used to spoof "MSIE 9.0; Windows NT 6.1", which in
#                 2026 is a bot signature that gets you blocked, not waved
#                 through. wget's own UA is honest and less suspicious; pass
#                 -U per invocation on the rare site that needs it.
#   robots      — `robots = off` ignores robots.txt for every recursive fetch
#                 by default. Opt into that per invocation (-e robots=off).
#   server_response — printing every HTTP header on every download is debug
#                 output; use -S when actually debugging.
#   follow_ftp  — following FTP links out of HTML pages is a 1998 default.
